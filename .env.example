# PostgreSQL connection (PGPASSWORD is read by the existing DB connector)
PGHOST=localhost
PGPORT=5432
PGDATABASE=warcdb
PGUSER=warc_user
PGPASSWORD=

# Embedding model settings
EMBEDDING_MODEL=BAAI/bge-m3-int8
EMBEDDING_MODEL_DIR=.models/bge-m3-int8
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_LENGTH=256
# 1.5 GiB YARN container for 2 GiB worker VMs
EMBEDDING_EXECUTOR_MEMORY=512m
EMBEDDING_EXECUTOR_MEMORY_OVERHEAD=1g

# Retrieval defaults
SUPPORTED_LANGUAGES=ar,en,fr
TOP_K=5
RAG_DB_CONCURRENCY=3
# RAG_PROVIDER: groq | gemini. Leave blank to infer from RAG_MODEL
# (gemini*/gemma* -> gemini, anything else -> groq).
RAG_PROVIDER=
# RAG_MODEL: blank uses the provider default
#   groq   -> openai/gpt-oss-120b   (needs RAG_REASONING_EFFORT=medium)
#   gemini -> gemini-3.5-flash-lite
RAG_MODEL=openai/gpt-oss-120b
RAG_REASONING_EFFORT=medium
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY=

# Cross-encoder reranking (runs in the RAG process, not Spark)
RERANKER_MODEL_DIR=.models/bge-reranker-v2-m3-int8
RERANKER_CANDIDATE_K=20
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=4
RERANKER_INTRA_OP_THREADS=1
