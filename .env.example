# PostgreSQL connection (PGPASSWORD is read by the existing DB connector)
PGHOST=localhost
PGPORT=5432
PGDATABASE=warcdb
PGUSER=warc_user
PGPASSWORD=

# Embedding model settings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Retrieval defaults
SUPPORTED_LANGUAGES=ar,en,fr
TOP_K=5
FINAL_K=3
