# PostgreSQL connection (PGPASSWORD is read by the existing DB connector)
PGHOST=localhost
PGPORT=5432
PGDATABASE=warcdb
PGUSER=warc_user
PGPASSWORD=

# Embedding model settings
EMBEDDING_MODEL=BAAI/bge-m3-int8
EMBEDDING_MODEL_DIR=.models/bge-m3-int8
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_LENGTH=256
# 1.5 GiB YARN container for 2 GiB worker VMs
EMBEDDING_EXECUTOR_MEMORY=512m
EMBEDDING_EXECUTOR_MEMORY_OVERHEAD=1g

# Retrieval defaults
SUPPORTED_LANGUAGES=ar,en,fr
TOP_K=5
FINAL_K=3
